# Robinhood Chain
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_KEY=

# Deployment
PRIVATE_KEY=
TREASURY=
PLATFORM_FEE_BPS=150
MIN_LP_LOCK_DURATION=15552000
MIN_VESTING_DURATION=2592000
MAX_VESTING_DURATION=63072000

# Uniswap v3 on Robinhood Chain MAINNET (chainId 4663) — verified 2026-07-29 by
# cross-checking three independent sources: (1) Uniswap's official deployments
# doc, (2) direct on-chain calls (NFPM.factory() / NFPM.WETH9() / factory
# owner() / factory.feeAmountTickSpacing() for fee tiers 500/3000/10000, all
# consistent), (3) Robinhood's own protocol-contracts doc, whose L2 WETH
# mainnet address matches NFPM.WETH9() exactly. Re-verify again yourself
# before any real deploy — do not take this file's word for it forever.
POSITION_MANAGER=0x73991a25C818Bf1f1128dEAaB1492D45638DE0D3
UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# Robinhood Chain TESTNET (chainId 46630)
# WETH below is confirmed via Robinhood's own protocol-contracts doc + a
# direct on-chain name()/symbol() call. POSITION_MANAGER / UNISWAP_V3_FACTORY
# are deliberately left blank: Uniswap has no official published testnet
# deployment page for Robinhood Chain, and the block explorer's search
# returned ~10 different "NonfungiblePositionManager"-named contracts with no
# reliable way to tell which (if any) is canonical for this chain. Do not
# guess one in — either get the address directly from Uniswap/Robinhood, or
# skip the testnet dry run and fork-test against mainnet instead.
POSITION_MANAGER_TESTNET=
UNISWAP_V3_FACTORY_TESTNET=
WETH_TESTNET=0x7943e237c7F95DA44E0301572D358911207852Fa

# DemoLaunch.s.sol only
FACTORY_ADDRESS=
